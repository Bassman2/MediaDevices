<UserControl x:Class="MediaDevicesDemo.View.DevicePropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MediaDevicesDemo.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Grid.Column="0" Grid.Row="0" Content="Name"/>
        <TextBox Grid.Column="1" Grid.Row="0" Text="{Binding Name, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="1" Content="Friendly Name"/>
        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding FriendlyName, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="2" Content="Manufacturer"/>
        <TextBox Grid.Column="1" Grid.Row="2" Text="{Binding Manufacturer, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="3" Content="Model"/>
        <TextBox Grid.Column="1" Grid.Row="3" Text="{Binding Model, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="4" Content="Firmware Version"/>
        <TextBox Grid.Column="1" Grid.Row="4" Text="{Binding FirmwareVersion, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="5" Content="Serial Number"/>
        <TextBox Grid.Column="1" Grid.Row="5" Text="{Binding SerialNumber, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="6" Content="Sync Partner"/>
        <TextBox Grid.Column="1" Grid.Row="6" Text="{Binding SyncPartner, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="7" Content="Power Source"/>
        <TextBox Grid.Column="1" Grid.Row="7" Text="{Binding PowerSource, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="8" Content="Power Level"/>
        <TextBox Grid.Column="1" Grid.Row="8" Text="{Binding PowerLevel, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="9" Content="Protocol"/>
        <TextBox Grid.Column="1" Grid.Row="9" Text="{Binding Protocol, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="10" Content="Date Time"/>
        <TextBox Grid.Column="1" Grid.Row="10" Text="{Binding DateTime, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="11" Content="DRM Schemes"/>
        <TextBox Grid.Column="1" Grid.Row="11" Text="{Binding SupportedDrmSchemes, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="12" Content="Device Type"/>
        <TextBox Grid.Column="1" Grid.Row="12" Text="{Binding DeviceType, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="13" Content="Transport"/>
        <TextBox Grid.Column="1" Grid.Row="13" Text="{Binding Transport, Mode=OneWay}" IsReadOnly="True" Margin="3"/>
        <Label Grid.Column="0" Grid.Row="14" Content="Device Stage"/>
        <TextBox Grid.Column="1" Grid.Row="14" Text="{Binding UseDeviceStage, Mode=OneWay}" IsReadOnly="True" Margin="3"/>

        <CheckBox Grid.Column="2" Grid.Row="0" Content="SupportsNonConsumable" IsChecked="{Binding SupportsNonConsumable, Mode=OneWay}" IsThreeState="True" IsHitTestVisible="False" Focusable="False" Margin="3"/>
        <CheckBox Grid.Column="2" Grid.Row="1" Content="SupportedFormatsAreOrdered" IsChecked="{Binding SupportedFormatsAreOrdered, Mode=OneWay}" IsThreeState="True" IsHitTestVisible="False" Focusable="False" Margin="3"/>
    </Grid>
</UserControl>
